{
  "name": "@dsh-external/dsh-cli-app",
  "description": "The dsh terminal interactive frontend: an Ink-based TUI over dsh-base, composed as an ordinary profile bundle (everything-is-a-plugin)",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^5.0.0",
    "react": "^18.2.0",
    "string-width": "^7.2.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-brand": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-util-values": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-skill": "^0.1.3-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-commands": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-tool-todo": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.3-alpha.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-commands": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-skill": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-tool-todo": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.3-alpha.1"
  }
}